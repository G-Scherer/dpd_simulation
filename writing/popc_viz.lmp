units lj
atom_style full 
boundary p p p 


bond_style harmonic
angle_style cosine/squared
kspace_style pppm 1.0e-4

read_data /home/gabriel/Dokumente/bachelor_thesis/dpd_simulation/bending_modulus/setup/bilayer_4096.data

variable seed equal 125
variable T equal 1.0

comm_modify vel yes

neigh_modify delay 0 check yes one 10000

pair_style dpd/coul/slater/long ${T} 1.0 ${seed} 1.185307217552 2.0
include pair.settings

timestep 0.01

fix 1 all nve

dump traj_gz all custom 1 large_bilayer.lammpstrj id mol type x y z

run 1