units lj
package gpu 1
atom_style full 
boundary p p p 

bond_style harmonic
angle_style cosine/squared
kspace_style pppm 1.0e-4


variable R equal 10

read_data /home/gabriel/Dokumente/bachelor_thesis/dpd_simulation/bending_modulus/setup/cylinder_${R}.data 
# read_data /remote/pi066a/scherer/dpd_simulation/bending_modulus/setup/cylinder_${R}.data 

group lipids type 1 2 3 5 6

variable seed equal 123
variable T equal 1.0

comm_modify vel yes

neigh_modify delay 0 check yes one 10000

compute press all pressure thermo_temp

variable lx equal lx
variable ly equal ly

variable sigma_trans equal (c_press[1] + c_press[2])/2.0

variable sigma_xx equal c_press[1] - v_sigma_trans
variable sigma_yy equal c_press[2] - v_sigma_trans
variable sigma_zz equal c_press[3] - v_sigma_trans

variable force_z equal v_sigma_zz*v_lx*v_ly

thermo 10000
thermo_modify lost warn flush yes
thermo_style custom step temp press c_press[1] c_press[2] c_press[3] v_sigma_xx v_sigma_yy v_sigma_zz v_force_z vol lx ly lz 

pair_style dpd/coul/slater/long/gpu ${T} 1.0 ${seed} 1.185307217552 2.0
include pair.settings

timestep 0.005

fix 1 all nve

run 200000

dump traj all custom 50000 cylinder_sim_${R}.lammpstrj id mol type x y z
dump_modify traj sort id 

fix 4 all ave/time 1 1 1 v_sigma_xx v_sigma_yy v_sigma_zz v_force_z file stress_and_force_${R}_differentapproach_big.dat

run 500000