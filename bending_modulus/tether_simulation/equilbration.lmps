units lj
package gpu 1
atom_style full 
boundary p p p 

bond_style harmonic
angle_style cosine/squared
kspace_style pppm 1.0e-3

# read_data /remote/pi066a/scherer/dpd_simulation/bending_modulus/tests/bilayer.data
read_data /home/gabriel/Dokumente/bachelor_thesis/dpd_simulation/bending_modulus/setup/cylinder.data 

variable seed equal 123
variable T equal 1.0

comm_modify vel yes

neigh_modify delay 0 check yes one 10000

compute mypress all pressure thermo_temp
variable forze_z equal c_mypress[3]*lx*ly

thermo 1000
thermo_modify lost warn flush yes
thermo_style custom step temp pxx pyy pzz v_force_z

pair_style dpd/coul/slater/long/gpu ${T} 1.0 ${seed} 1.185307217552 2.0
include pair.settings

timestep 0.01

fix 1 all nve

run 100000

dump traj all custom 10000 bilayer.lammpstrj id mol type x y z
dump_modify traj sort id 

fix 2 all ave/time 1 1000 1000 v_force_z file tether_force.dat

run 1000000