units lj
package gpu 1 
atom_style full 
boundary p p p 

newton off

bond_style harmonic
angle_style cosine/squared
kspace_style pppm 1.0e-3

# read_data /remote/pi066a/scherer/dpd_simulation/bending_modulus/tests/bilayer_new_try.data
read_data /home/gabriel/Dokumente/bachelor_thesis/dpd_simulation/bending_modulus/setup/bilayer_big.data 

variable seed equal 125
variable T equal 1.0
variable p equal 77

# bilayer: 79.147522
# water: 90.93464338

comm_modify vel yes

neigh_modify delay 0 check yes one 10000

variable lat_tension equal 0.5*lz*(pzz - (pxx + pyy)*0.5)

thermo_style custom step temp press pxx pyy pzz v_lat_tension vol
thermo 10000
thermo_modify lost warn flush yes
velocity all create ${T} ${seed} dist gaussian

pair_style dpd/coul/slater/long/gpu ${T} 1.0 ${seed} 1.185307217552 2.0
include pair.settings

# skip first 1000 t for bilayer equilibration

timestep 0.01

#fix 1 all nve
fix 2 all nph aniso ${p} ${p} 1000.0 couple xy 
fix 3 all ave/time 1 1 1 v_lat_tension file tension_profile_${p}.dat
#fix 2 all press/berendsen x ${p} ${p} 5000 y ${p} ${p} 5000 z ${p} ${p} 5000 couple xy

run 100000

dump traj all custom 10000 bilayer_nph_${p}.lammpstrj id mol type x y z


run 500000