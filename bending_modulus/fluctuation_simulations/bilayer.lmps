units lj
package gpu 1 
atom_style full 
boundary p p p 

newton off

bond_style harmonic
angle_style cosine/squared
kspace_style pppm 1.0e-3

# read_data /remote/pi066a/scherer/dpd_simulation/bending_modulus/setup/bilayer_new_try.data
read_data /home/gabriel/Dokumente/bachelor_thesis/dpd_simulation/bending_modulus/setup/bilayer_4096.data 

variable seed equal 125
variable T equal 1.0
variable p equal 79.147522

# bilayer 8192: 77.03488858556462
# bilayer 4096: 79.147522

comm_modify vel yes

neigh_modify delay 0 check yes one 10000

variable lat_tension equal 0.5*lz*(pzz - (pxx + pyy)*0.5)

thermo_style custom step temp press pxx pyy pzz v_lat_tension vol
thermo 10000
thermo_modify lost warn flush yes
velocity all create ${T} ${seed} dist gaussian

pair_style dpd/coul/slater/long/gpu ${T} 1.0 ${seed} 1.185307217552 2.0
include pair.settings


timestep 0.001

fix 2 all nph aniso ${p} ${p} 10.0 couple xy 

run 100000

dump traj_gz all custom 1000 bilayer_acf.lammpstrj id mol type x y z
fix 1 all ave/time 1 1 1 v_lat_tension file tension_profile.dat

run 100000